{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LynVault",
  "version": "3.0.0",
  "identifier": "com.lynvortex.LynVault",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src 'self' ipc: http://ipc.localhost http://lynvault-media.localhost lynvault-media:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; form-action 'none'; frame-src 'none'"
    },
    "windows": []
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "desktopTemplate": "linux/lynvault.desktop",
        "files": {
          "/usr/share/mime/packages/lynvault.xml": "linux/lynvault-mime.xml",
          "/usr/share/icons/hicolor/32x32/mimetypes/application-x-lynvault-vault.png": "icons/32x32.png",
          "/usr/share/icons/hicolor/128x128/mimetypes/application-x-lynvault-vault.png": "icons/128x128.png"
        }
      }
    }
  }
}
